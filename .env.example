# Database
DATABASE_URL="postgresql://user:password@localhost:5432/apple_newton"

# Encryption key for environment variables (REQUIRED - minimum 32 characters)
# Generate a secure key using: openssl rand -hex 32
ENCRYPTION_KEY="your-secure-random-32-byte-hex-key-here-change-me-to-random-value"

# Encryption salt for key derivation (REQUIRED - minimum 16 characters)
# Generate a secure salt using: openssl rand -hex 32
ENCRYPTION_SALT="your-secure-random-salt-here-change-me-to-random-value"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# OAuth - HCA
HCA_CLIENT_ID="your-hca-client-id"
HCA_CLIENT_SECRET="your-hca-client-secret"
HCA_AUTHORIZATION_URL="https://hca.example.com/oauth/authorize"
HCA_TOKEN_URL="https://hca.example.com/oauth/token"
HCA_USERINFO_URL="https://hca.example.com/oauth/userinfo"

# OAuth - GitHub
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# App Store Connect
APP_STORE_CONNECT_KEY_ID="your-key-id"
APP_STORE_CONNECT_ISSUER_ID="your-issuer-id"
APP_STORE_CONNECT_PRIVATE_KEY="your-private-key"
APPLE_ID="your-apple-id-email"
APPLE_PASSWORD="your-apple-password"
APPLE_APP_SPECIFIC_PASSWORD="your-app-specific-password"
APPLE_TEAM_ID="your-team-id"

# Slack
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_SIGNING_SECRET="your-slack-signing-secret"
SLACK_ADMIN_CHANNEL_ID="your-admin-channel-id"

# EAS Build
EXPO_TOKEN="your-expo-token"
EAS_LOCAL_BUILD="false"

# Redis (for Bull queue)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

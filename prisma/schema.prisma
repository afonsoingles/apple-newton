// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  githubId          String?  @unique
  githubAccessToken String?
  isAdmin           Boolean  @default(false)
  slackUserId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  apps    App[]
  reviews BuildReview[]

  @@index([email])
  @@index([githubId])
}

model App {
  id               String   @id @default(cuid())
  userId           String
  name             String
  bundleIdentifier String
  githubRepo       String
  githubOwner      String
  appConfig        Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  builds Build[]

  @@index([userId])
  @@index([githubOwner, githubRepo])
}

model Build {
  id                   String   @id @default(cuid())
  appId                String
  buildType            String // 'development', 'production', 'custom'
  status               String   @default("pending")
  bundleIdentifier     String
  easConfig            Json?
  environmentVariables Json? // Encrypted
  ipaUrl               String?
  buildLogs            String?  @db.Text
  appleReviewData      Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  app    App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  review BuildReview?

  @@index([appId])
  @@index([status])
  @@index([buildType])
}

model BuildReview {
  id         String   @id @default(cuid())
  buildId    String   @unique
  reviewerId String
  approved   Boolean
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  build    Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  reviewer User  @relation(fields: [reviewerId], references: [id])

  @@index([reviewerId])
  @@index([buildId])
}

model Certificate {
  id          String   @id @default(cuid())
  name        String
  type        String // 'distribution', 'development'
  certificate String   @db.Text // Encrypted
  privateKey  String   @db.Text // Encrypted
  teamId      String
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
}
